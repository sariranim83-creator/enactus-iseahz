# === Supabase ===
# Found in your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: server-only, NEVER expose to the browser / never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Site ===
NEXT_PUBLIC_SITE_URL=https://enactusiseahz.tn

# === Admin bootstrap (optional) ===
# Used only by scripts/create-admin.ts to create the first admin user.
ADMIN_BOOTSTRAP_EMAIL=admin@enactusiseahz.tn
ADMIN_BOOTSTRAP_PASSWORD=change-me-before-running
